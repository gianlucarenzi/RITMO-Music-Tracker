# Makefile - the RMT Atari binaries from the ca65 sources (cc65 instead of MADS/XASM), see README.md
#
#   make            the drivers and players into build/
#   make players    the Simple RMT Player (XEX, SAP) and the RMT Visualizer with asm/Patch-16/music.rmt
#   make xexplayers the players of the XEX export with the RMT player, and their addresses (build/rmt_xex.h)
#   make install-xexplayers   copy them to rmt/resources/players and src/rmt_xex.h
#   make check      also compare the drivers with those RMT uses (rmt/resources/drivers)
#   make sources    translate the MADS sources of asm/ again (scripts/mads2ca65.py)
#   make clean

OBX     = ./obx.sh
BUILD   = build
DRIVERS = ../../rmt/resources/drivers

# Patch16 RMT driver (tracker.obx = rmt_driver_v6.obx): asm/Patch-16/rmtplayr.a65 with rmt_feat.a65 as it is
# RMT 1.28 driver (rmt_ata.sys = rmt_driver_v1.obx): asm/Legacy/rmt_ata.a65
# RMT 1.28 SAP players for 4 and 8 tracks, XEX export routine: asm/Legacy/rmt_sap4/8.a65, rmt_msx.a65
# RMF player with its test song: asm/Legacy/rmf/rmf_play.a65
TARGETS = $(BUILD)/rmt_driver_v6.obx $(BUILD)/rmt_driver_v1.obx \
          $(BUILD)/rmt_sap4.obx $(BUILD)/rmt_sap8.obx $(BUILD)/rmt_msx.obx \
          $(BUILD)/rmf_play.xex

# Simple RMT Player (XEX or SAP with music.rmt) and RMT Visualizer (XEX with music.rmt) of Patch-16: the player
# routine as FEAT_IS_SIMPLEP (at $3100)
PLAYERS = $(BUILD)/rmtplayer.xex $(BUILD)/rmtplayer.sap $(BUILD)/rmtvis.xex

# The players of the "XEX Atari executable + RMT player" export of RITMO, without a module (RITMO adds it at $4000,
# with the text and the rasterbar colour):
#   driver Unpatched (1, 2): RMT 1.28, Legacy/rmt_xex.s (the player at $3400) + Legacy/rmt_msx.s (the XEX routine
#                            at $3E00, text at $3F00), as Rmt.exe 1.28 exported them; mono and stereo
#   driver Patch16 (6):      the Simple RMT Player, Patch-16/rmtplayer.s with RITMOEXPORT=1; mono and stereo, for a
#                            PAL and for an NTSC song (REGIONPLAYBACK)
XEXPLAYERS = $(BUILD)/rmt_xex_v1_mono.obx $(BUILD)/rmt_xex_v1_stereo.obx \
             $(BUILD)/rmt_xex_v6_mono_pal.obx $(BUILD)/rmt_xex_v6_mono_ntsc.obx \
             $(BUILD)/rmt_xex_v6_stereo_pal.obx $(BUILD)/rmt_xex_v6_stereo_ntsc.obx
V6SYMBOLS  = line_0 line_1 rasterbar_colour start
MSXSYMBOLS = start video color vcaddition MODUL
SIMPLEP    = -D FEAT_IS_TRACKER=0 -D FEAT_IS_SIMPLEP=1 -D RITMOEXPORT=1
RESOURCES  = ../../rmt/resources/players

PATCH16 = $(wildcard Patch-16/*.s)
LEGACY  = $(wildcard Legacy/*.s)
RMF     = $(wildcard Legacy/rmf/*.s)
COMMON  = mads.inc obx.cfg obx.sh

all: $(TARGETS)

players: $(PLAYERS)

$(BUILD):
	mkdir -p $@

$(BUILD)/rmt_driver_v6.obx: $(PATCH16) $(COMMON) | $(BUILD)
	$(OBX) $@ Patch-16/rmtplayr.s

$(BUILD)/rmt_driver_v1.obx: $(LEGACY) $(COMMON) | $(BUILD)
	$(OBX) $@ Legacy/rmt_ata.s

$(BUILD)/rmt_sap4.obx $(BUILD)/rmt_sap8.obx $(BUILD)/rmt_msx.obx: $(BUILD)/%.obx: $(LEGACY) $(COMMON) | $(BUILD)
	$(OBX) $@ Legacy/$*.s

$(BUILD)/rmf_play.xex: $(RMF) $(COMMON) | $(BUILD)
	$(OBX) $@ Legacy/rmf/rmf_play.s

$(BUILD)/rmtplayer.xex: $(PATCH16) $(COMMON) | $(BUILD)
	$(OBX) $@ Patch-16/rmtplayer.s -D FEAT_IS_TRACKER=0 -D FEAT_IS_SIMPLEP=1

$(BUILD)/rmtplayer.sap: $(PATCH16) $(COMMON) | $(BUILD)
	$(OBX) $@ Patch-16/rmtplayer.s -D FEAT_IS_TRACKER=0 -D FEAT_IS_SIMPLEP=1 -D EXPORTXEX=0 -D EXPORTSAP=1

$(BUILD)/rmtvis.xex: $(PATCH16) $(COMMON) | $(BUILD)
	$(OBX) $@ Patch-16/rmtvis.s -D FEAT_IS_TRACKER=0 -D FEAT_IS_SIMPLEP=1

xexplayers: $(XEXPLAYERS) $(BUILD)/rmt_xex.h

$(BUILD)/rmt_xex_msx.obx: $(LEGACY) $(COMMON) | $(BUILD)
	OBX_SYMBOLS="$(MSXSYMBOLS)" $(OBX) $@ Legacy/rmt_msx.s >$(BUILD)/rmt_xex_msx.sym

$(BUILD)/rmt_xex_v1_mono.obx $(BUILD)/rmt_xex_v1_stereo.obx: $(BUILD)/rmt_xex_v1_%.obx: $(LEGACY) $(COMMON) $(BUILD)/rmt_xex_msx.obx
	$(OBX) $(BUILD)/rmt_xex_player_$*.obx Legacy/rmt_xex.s -D STEREOMODE=$(if $(filter stereo,$*),1,0)
	cat $(BUILD)/rmt_xex_player_$*.obx $(BUILD)/rmt_xex_msx.obx >$@

$(BUILD)/rmt_xex_v6_%.obx: $(PATCH16) $(COMMON) | $(BUILD)
	OBX_SYMBOLS="$(V6SYMBOLS)" $(OBX) $@ Patch-16/rmtplayer.s $(SIMPLEP) \
		-D STEREOMODE=$(if $(findstring stereo,$*),1,0) -D REGIONPLAYBACK=$(if $(findstring ntsc,$*),1,0) \
		>$(BUILD)/rmt_xex_v6_$*.sym

# the addresses RITMO patches, from the OBX_SYMBOL lines of the builds
$(BUILD)/rmt_xex.h: $(XEXPLAYERS)
	( echo "// generated by asm/ca65/Makefile (make xexplayers) - do not edit"; \
	  echo "// the addresses the XEX export with the RMT player patches in rmt/resources/players/rmt_xex_*.obx"; \
	  echo "#pragma once"; \
	  for f in $(BUILD)/rmt_xex_msx.sym $(BUILD)/rmt_xex_v6_*.sym; do \
	      n=$$(basename $$f .sym | sed 's/^rmt_xex_//' | tr a-z A-Z); \
	      awk -v n=$$n '$$1 == "OBX_SYMBOL" { printf "#define RMTXEX_%s_%s 0x%s\n", n, toupper($$2), $$3 }' $$f; \
	  done ) >$@

install-xexplayers: xexplayers
	cp $(XEXPLAYERS) $(RESOURCES)/
	cp $(BUILD)/rmt_xex.h ../../src/rmt_xex.h

check: $(BUILD)/rmt_driver_v6.obx $(BUILD)/rmt_driver_v1.obx
	cmp $(BUILD)/rmt_driver_v6.obx $(DRIVERS)/rmt_driver_v6.obx
	cmp $(BUILD)/rmt_driver_v1.obx $(DRIVERS)/rmt_driver_v1.obx
	@echo "check: the drivers are identical to rmt_driver_v6.obx and rmt_driver_v1.obx"

sources:
	cd ../.. && python3 scripts/mads2ca65.py asm asm/ca65

clean:
	rm -rf $(BUILD)

.PHONY: all players xexplayers install-xexplayers check sources clean
