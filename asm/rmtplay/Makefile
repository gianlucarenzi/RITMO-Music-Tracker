# Makefile - the players of the "XEX Atari executable + RMT player" export of RITMO (see README.md)
#
#   make            build/rmtplay_v1_mono.xex, _v1_stereo, _v6_mono, _v6_stereo and build/rmt_xex.h
#   make install    copy them to rmt/resources/players and src/rmt_xex.h
#   make clean
#
# Each one is the visualizer (rmtplay.c, from RMTPLAY of VERA_ATARI_PBI, ANTIC only) with the RMT player of a
# tracker driver, without a module (the tracker adds it after the program, with the info lines):
#   v1  driver Unpatched: the RMT 1.28 player, asm/Legacy/rmt_xex.a65 at $3400
#   v6  driver Patch16:   asm/Patch-16/rmtplayr.a65 at $3100 (FEAT_IS_SIMPLEP), its frequency tables at $3A00
#   mono for RMT4, stereo for RMT8 (8 tracks: the player writes the second POKEY, $D210)
# Needs cc65 (cl65, ca65, ld65), make, awk; the players are assembled by ../ca65/obx.sh.

CL      ?= cl65
OBX     = ../ca65/obx.sh
BUILD   = build
VARIANTS = v1_mono v1_stereo v6_mono v6_stereo
XEX     = $(foreach v,$(VARIANTS),$(BUILD)/rmtplay_$(v).xex)
SOURCES = rmtplay.c rmtxex.s rmtdli.s rmtplay.cfg
RESOURCES = ../../rmt/resources/players

# the symbols of the players (the names differ between RMT 1.28 and Patch16) -> player_*.inc
V1SYMS  = RASTERMUSICTRACKER p_song v_abeat v_maxtracklen v_speed trackn_audf trackn_audc v_audctl
V6SYMS  = RASTERMUSICTRACKER ptrSongLines smc_abeat smc_maxtracklen smc_speed trackn_audf trackn_audc v_audctl TABLES
V6OPTS  = -D FEAT_IS_TRACKER=0 -D FEAT_IS_SIMPLEP=1 -D EXPORTXEX=0 -D EXPORTSAP=0 -D TABLES=\$$3A00

stereo  = $(if $(findstring stereo,$(1)),1,0)

all: $(XEX) $(BUILD)/rmt_xex.h

$(BUILD):
	mkdir -p $@

$(BUILD)/player_v1_%.obx: $(wildcard ../ca65/Legacy/*.s) | $(BUILD)
	OBX_SYMBOLS="$(V1SYMS) $(if $(findstring stereo,$*),v_audctl2)" $(OBX) $@ ../ca65/Legacy/rmt_xex.s \
		-D STEREOMODE=$(call stereo,$*) >$(BUILD)/player_v1_$*.sym

$(BUILD)/player_v6_%.obx: $(wildcard ../ca65/Patch-16/*.s) | $(BUILD)
	OBX_SYMBOLS="$(V6SYMS) $(if $(findstring stereo,$*),v_audctl2)" $(OBX) $@ ../ca65/Patch-16/rmtplayr.s $(V6OPTS) \
		-D STEREOMODE=$(call stereo,$*) >$(BUILD)/player_v6_$*.sym

# OBX_SYMBOL lines -> the RMT_* names of rmtxex.s
$(BUILD)/player_%.inc: $(BUILD)/player_%.obx
	awk 'BEGIN { n["RASTERMUSICTRACKER"] = "RMT_PLAYER"; n["p_song"] = n["ptrSongLines"] = "RMT_P_SONG"; \
	             n["v_abeat"] = n["smc_abeat"] = "RMT_ABEAT"; n["v_maxtracklen"] = n["smc_maxtracklen"] = "RMT_MAXTRACKLEN"; \
	             n["v_speed"] = n["smc_speed"] = "RMT_SPEED"; n["trackn_audf"] = "RMT_AUDF"; n["trackn_audc"] = "RMT_AUDC"; \
	             n["v_audctl"] = "RMT_AUDCTL"; n["v_audctl2"] = "RMT_AUDCTL2"; n["TABLES"] = "RMT_TABLES" } \
	     $$1 == "OBX_SYMBOL" { print n[$$2] " = $$" $$3 }' $(BUILD)/player_$*.sym >$@

# the program (cc65 atari, rmtplay.cfg), then the player: one XEX
$(BUILD)/rmtplay_%.xex: $(SOURCES) $(BUILD)/player_%.inc $(BUILD)/player_%.obx
	cp $(BUILD)/player_$*.inc $(BUILD)/player.inc
	$(CL) -t atari -Osir -C rmtplay.cfg --asm-include-dir $(BUILD) -DRMT_TRACKS=$(if $(findstring stereo,$*),8,4) \
		-Ln $(BUILD)/rmtplay_$*.lbl -m $(BUILD)/rmtplay_$*.map -o $(BUILD)/program_$*.xex rmtplay.c rmtxex.s rmtdli.s
	rm -f rmtplay.o rmtxex.o rmtdli.o $(BUILD)/player.inc
	cat $(BUILD)/program_$*.xex $(BUILD)/player_$*.obx >$@

# the addresses the tracker patches: from the labels of the programs and the symbols of the players
$(BUILD)/rmt_xex.h: $(XEX)
	( echo "// generated by asm/rmtplay/Makefile - do not edit"; \
	  echo "// the addresses the XEX export with the RMT player patches in rmt/resources/players/rmtplay_*.xex"; \
	  echo "#pragma once"; \
	  for v in $(VARIANTS); do \
	      V=$$(echo $$v | tr a-z A-Z); \
	      awk -v V=$$V '{ s = $$3; sub(/^\./, "", s) } \
	          s == "_rmt_song" || s == "_rmt_song_end" || s == "_rmt_song_ntsc" || s == "_rmt_info" || s == "__MAIN_LAST__" { \
	              n = toupper(s); sub(/^_+/, "", n); if (n == "MAIN_LAST__") n = "MODULE"; printf "#define RMTXEX_%s_%s 0x%s\n", V, n, substr($$2, 3) }' \
	          $(BUILD)/rmtplay_$$v.lbl | sort -u; \
	      awk -v V=$$V '$$1 == "RMT_TABLES" { printf "#define RMTXEX_%s_TABLES 0x%s\n", V, substr($$3, 2) }' $(BUILD)/player_$$v.inc; \
	  done; \
	  echo "#define RMTXEX_INFO_MAX 200            // characters of an info line (rmtplay.c INFO_MAX)"; \
	  echo "#define RMTXEX_MODULE_LIMIT 0xB820     // \$$BC20 - the C stack (\$$400, rmtplay.cfg): the module ends below") >$@

install: all
	cp $(XEX) $(RESOURCES)/
	cp $(BUILD)/rmt_xex.h ../../src/rmt_xex.h

clean:
	rm -rf $(BUILD) rmtplay.o rmtxex.o rmtdli.o

.PHONY: all install clean
